{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/terminal-title/hooks/set-title-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/auto-sync-config.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing ~/.claude config to GitHub..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "superpowers@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "cloudflare@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "rampstack-starter@rampstack": true,
    "agent-skills@addy-agent-skills": true,
    "fullstack-dev-skills@fullstack-dev-skills": false,
    "voltagent-core-dev@voltagent-subagents": true,
    "voltagent-lang@voltagent-subagents": true,
    "voltagent-infra@voltagent-subagents": true,
    "voltagent-qa-sec@voltagent-subagents": true,
    "voltagent-data-ai@voltagent-subagents": true,
    "voltagent-dev-exp@voltagent-subagents": true,
    "voltagent-domains@voltagent-subagents": true,
    "voltagent-biz@voltagent-subagents": true,
    "voltagent-meta@voltagent-subagents": true,
    "voltagent-research@voltagent-subagents": true,
    "agentcairn@agentcairn": true,
    "avoid-ai-writing@conorbronsdon-skills": true,
    "web-animation-skills@web-animation-skills": true,
    "motion-design-skills@motion-design-skills": true,
    "compound-engineering@compound-engineering-plugin": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "rampstack": {
      "source": {
        "source": "github",
        "repo": "rampstackco/claude-skills"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    },
    "fullstack-dev-skills": {
      "source": {
        "source": "github",
        "repo": "Jeffallan/claude-skills"
      }
    },
    "voltagent-subagents": {
      "source": {
        "source": "github",
        "repo": "VoltAgent/awesome-claude-code-subagents"
      }
    },
    "agentcairn": {
      "source": {
        "source": "github",
        "repo": "ccf/agentcairn"
      }
    },
    "conorbronsdon-skills": {
      "source": {
        "source": "github",
        "repo": "conorbronsdon/avoid-ai-writing"
      }
    },
    "web-animation-skills": {
      "source": {
        "source": "github",
