{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/terminal-title/hooks/set-title-hook.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/auto-sync-config.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing ~/.claude config to GitHub..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "superpowers@claude-plugins-official": true,
    "supabase@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "cloudflare@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "rampstack-starter@rampstack": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "rampstack": {
      "source": {
        "source": "github",
        "repo": "rampstackco/claude-skills"
      }
    }
  }
}
