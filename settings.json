{
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {},
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/scripts/auto-sync-config.sh 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Syncing ~/.claude config to GitHub..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "warp@claude-code-warp": true,
    "ponytail@ponytail": true,
    "stripe@claude-plugins-official": true,
    "agent-skills@addy-agent-skills": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "addy-agent-skills": {
      "source": {
        "source": "github",
        "repo": "addyosmani/agent-skills"
      }
    }
  }
}
